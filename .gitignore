# ─────────────────────────────────────────────
#  VOLAMP ELECTRICALS — .gitignore
#  Node.js · React/Vite · Prisma/SQLite
# ─────────────────────────────────────────────

# ── Dependencies ─────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Environment variables (never commit) ─────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
.env.example


# ── Production builds ─────────────────────────
dist/
build/
frontend/dist/

# ── Database files ────────────────────────────
backend/prisma/*.db
backend/prisma/*.db-journal
backend/prisma/*.db-shm
backend/prisma/*.db-wal

# ── Prisma generated client ───────────────────
backend/node_modules/.prisma/

# ── Logs ─────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── OS & Editor ───────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Testing ───────────────────────────────────
coverage/
.nyc_output/

# ── Misc ──────────────────────────────────────
.cache/
.temp/
*.tgz
*.zip
